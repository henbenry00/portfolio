---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import Background from '../components/Background.astro';
import { getFileLastCommitISO, getRepoLastCommit, formatRelative } from '../lib/buildInfo';

const STATUS_META: Record<string, { label: string; color: string }> = {
	operational: { label: 'Operational', color: '#5eeb8f' },
	'in-development': { label: 'In Development', color: '#ffb454' },
	prototype: { label: 'Prototype', color: '#7cc7ff' },
	archived: { label: 'Archived', color: '#8a92a3' },
};

const dataDir = path.join(process.cwd(), 'src/data/projects');
const files = fs
	.readdirSync(dataDir)
	.filter((f) => f.endsWith('.json'))
	.sort();

const projects = files.map((file, i) => {
	const filePath = path.join(dataDir, file);
	const relPath = path.relative(process.cwd(), filePath);
	const data = JSON.parse(fs.readFileSync(filePath, 'utf-8'));
	const commitISO = getFileLastCommitISO(relPath) ?? fs.statSync(filePath).mtime.toISOString();
	return {
		id: String(i + 1).padStart(2, '0'),
		name: data.name as string,
		description: data.description as string,
		status: STATUS_META[data.status] ?? STATUS_META.prototype,
		updated: formatRelative(commitISO),
	};
});

const build = getRepoLastCommit();
---

<Layout title="Ben Henry — Projects" description="Projects by Ben Henry.">
	<Background />

	<main>
		<a id="back" href="/">← Home</a>

		<header>
			<h1>Projects</h1>
			{
				build && (
					<p id="build-info">
						<span class="dot" />
						build <code>{build.hash}</code> · deployed {formatRelative(build.date)} · {
							projects.length
						}{' '}
						projects tracked
					</p>
				)
			}
		</header>

		<section id="grid">
			{
				projects.map((project) => (
					<article class="card">
						<div class="card-top">
							<span class="index">PRJ_{project.id}</span>
							<span class="status" style={`--status-color: ${project.status.color}`}>
								<span class="status-dot" />
								{project.status.label}
							</span>
						</div>
						<h2>{project.name}</h2>
						<p>{project.description}</p>
						<p class="updated">updated {project.updated}</p>
					</article>
				))
			}
		</section>
	</main>
</Layout>

<style>
	main {
		min-height: 100%;
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		color: #f5f5f5;
		padding: 4rem 1.5rem 5rem;
		max-width: 72rem;
		margin: 0 auto;
	}

	#back {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		color: #7ba9e0;
		text-decoration: none;
		font-size: 0.9rem;
		border: 1px solid rgba(94, 158, 255, 0.3);
		background: rgba(94, 158, 255, 0.08);
		padding: 0.5em 1em;
		border-radius: 8px;
		transition:
			background 0.15s ease,
			border-color 0.15s ease;
	}

	#back:hover {
		background: rgba(94, 158, 255, 0.16);
		border-color: rgba(94, 158, 255, 0.6);
	}

	header {
		margin-top: 3rem;
		text-align: center;
	}

	h1 {
		font-size: clamp(2.25rem, 6vw, 3.5rem);
		margin: 0;
		letter-spacing: -0.02em;
	}

	#build-info {
		margin: 0.9rem 0 0;
		font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace;
		font-size: 0.75rem;
		color: #5b6270;
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
	}

	#build-info code {
		color: #7c8291;
	}

	.dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #4ade80;
		box-shadow: 0 0 6px rgba(74, 222, 128, 0.7);
		animation: pulse 2.5s ease-in-out infinite;
	}

	@keyframes pulse {
		0%,
		100% {
			opacity: 0.6;
		}
		50% {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dot {
			animation: none;
		}
	}

	#grid {
		margin-top: 3.5rem;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.25rem;
	}

	.card {
		background: #111318;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		padding: 1.75rem;
		transition:
			border-color 0.15s ease,
			transform 0.15s ease;
	}

	.card:hover {
		border-color: rgba(94, 158, 255, 0.4);
		transform: translateY(-2px);
	}

	.card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1rem;
	}

	.index {
		font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		color: #565d6b;
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--status-color);
	}

	.status-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--status-color);
		box-shadow: 0 0 6px var(--status-color);
	}

	.card h2 {
		margin: 0 0 0.5em;
		font-size: 1.25rem;
		letter-spacing: -0.01em;
	}

	.card p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
		color: #9299a8;
	}

	.card .updated {
		margin-top: 1rem;
		font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace;
		font-size: 0.7rem;
		color: #565d6b;
	}
</style>
