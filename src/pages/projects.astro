---
import Layout from '../layouts/Layout.astro';
import SpaceBackground from '../components/SpaceBackground.astro';

const projects = [
	{
		id: '01',
		name: 'MyChurchHelper',
		description:
			'A worship management platform for churches — chord charts, lyrics, and key transposition, self-hosted end to end.',
		status: 'In Development',
		statusColor: '#ffb454',
	},
	{
		id: '02',
		name: 'MTB Trail App',
		description:
			'Community-driven mountain bike trail conditions, built on OpenStreetMap data with a React + MapLibre frontend.',
		status: 'Prototype',
		statusColor: '#7cc7ff',
	},
	{
		id: '03',
		name: 'MCH Dongle',
		description:
			'A Raspberry Pi kiosk device that drives the TV or projector display for churches running MyChurchHelper.',
		status: 'In Development',
		statusColor: '#ffb454',
	},
	{
		id: '04',
		name: 'Homelab Infrastructure',
		description:
			'TrueNAS SCALE server running Docker workloads, Tailscale networking, and a Cloudflare Tunnel front door.',
		status: 'Operational',
		statusColor: '#5eeb8f',
	},
];
---

<Layout title="Ben Henry — Projects" description="Projects by Ben Henry.">
	<SpaceBackground />

	<main>
		<a id="back" href="/">← Home</a>

		<header>
			<p id="eyebrow">// mission log</p>
			<h1>Projects</h1>
		</header>

		<section id="grid">
			{
				projects.map((project) => (
					<article class="card">
						<div class="card-top">
							<span class="index">PRJ_{project.id}</span>
							<span class="status" style={`--status-color: ${project.statusColor}`}>
								<span class="dot" />
								{project.status}
							</span>
						</div>
						<h2>{project.name}</h2>
						<p>{project.description}</p>
					</article>
				))
			}
		</section>
	</main>
</Layout>

<style>
	main {
		min-height: 100%;
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		color: #f5f5f5;
		padding: 4rem 1.5rem 5rem;
		max-width: 72rem;
		margin: 0 auto;
	}

	#back {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		color: #7cc7ff;
		text-decoration: none;
		font-size: 0.9rem;
		letter-spacing: 0.02em;
		border: 1px solid rgba(124, 199, 255, 0.35);
		background: rgba(124, 199, 255, 0.08);
		padding: 0.5em 1em;
		border-radius: 999px;
		transition:
			background 0.2s ease,
			border-color 0.2s ease;
	}

	#back:hover {
		background: rgba(124, 199, 255, 0.18);
		border-color: rgba(124, 199, 255, 0.6);
	}

	header {
		margin-top: 3rem;
		text-align: center;
	}

	#eyebrow {
		font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace;
		color: #7cc7ff;
		letter-spacing: 0.12em;
		font-size: 0.85rem;
		margin: 0 0 0.5em;
		text-transform: uppercase;
	}

	h1 {
		font-size: clamp(2.25rem, 6vw, 3.5rem);
		margin: 0;
		letter-spacing: -0.02em;
		text-shadow: 0 0 30px rgba(124, 199, 255, 0.35);
	}

	#grid {
		margin-top: 3.5rem;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
	}

	.card {
		background: rgba(12, 16, 28, 0.82);
		border: 1px solid rgba(124, 199, 255, 0.25);
		border-radius: 16px;
		padding: 1.75rem;
		box-shadow:
			0 20px 50px rgba(0, 0, 0, 0.4),
			inset 0 1px 0 rgba(255, 255, 255, 0.05);
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	.card:hover {
		border-color: rgba(124, 199, 255, 0.55);
		transform: translateY(-2px);
	}

	.card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1rem;
	}

	.index {
		font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		color: #5b6b8c;
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--status-color);
	}

	.dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--status-color);
		box-shadow: 0 0 8px var(--status-color);
	}

	.card h2 {
		margin: 0 0 0.5em;
		font-size: 1.25rem;
		letter-spacing: -0.01em;
	}

	.card p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
		color: #a3adc2;
	}
</style>
