---
import Layout from '../layouts/Layout.astro';
import SpaceBackground from '../components/SpaceBackground.astro';
---

<Layout>
	<SpaceBackground />
	<main>
		<div id="card">
			<h1>Ben Henry</h1>
			<p id="title">DevOps & Infrastructure Engineer</p>
			<p id="description">
				Building self-hosted systems, automation, and full-stack projects.
			</p>
			<a id="badge" href="/projects">See Projects</a>
		</div>
	</main>
</Layout>

<style>
	main {
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		color: #f5f5f5;
		padding: 16px;
	}

	#card {
		background: rgba(12, 16, 28, 0.82);
		border: 1px solid rgba(124, 199, 255, 0.25);
		border-radius: 28px;
		padding: 3rem 3.5rem;
		box-shadow:
			0 20px 60px rgba(0, 0, 0, 0.4),
			inset 0 1px 0 rgba(255, 255, 255, 0.05);
		max-width: 90vw;
	}

	h1 {
		font-size: clamp(2.5rem, 6vw, 4rem);
		margin: 0;
		letter-spacing: -0.02em;
		text-shadow: 0 0 30px rgba(124, 199, 255, 0.35);
	}

	#title {
		margin: 0.75em 0 0;
		font-size: 1.15rem;
		color: #8fb8e0;
		font-weight: 600;
	}

	#description {
		margin: 0.5em 0 0;
		font-size: 1rem;
		color: #a3adc2;
		max-width: 32em;
	}

	#badge {
		display: inline-block;
		margin-top: 2em;
		padding: 0.65em 1.5em;
		border: 1px solid rgba(124, 199, 255, 0.45);
		border-radius: 999px;
		font-size: 0.85rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		color: #bcdcfb;
		background: rgba(124, 199, 255, 0.08);
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	#badge:hover {
		background: rgba(124, 199, 255, 0.18);
		border-color: rgba(124, 199, 255, 0.7);
		transform: translateY(-1px);
	}
</style>
