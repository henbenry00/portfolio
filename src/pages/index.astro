---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div id="bg"></div>
	<main>
		<h1>Ben Henry</h1>
		<p id="title">DevOps & Infrastructure Engineer</p>
		<p id="description">
			Building self-hosted systems, automation, and full-stack projects.
		</p>
		<p id="badge">Coming Soon</p>
	</main>
</Layout>

<style>
	#bg {
		position: fixed;
		inset: -10%;
		z-index: -1;
		background:
			radial-gradient(circle at 20% 30%, rgba(220, 222, 228, 0.35), transparent 55%),
			radial-gradient(circle at 78% 25%, rgba(190, 193, 200, 0.3), transparent 50%),
			radial-gradient(circle at 50% 78%, rgba(205, 207, 214, 0.28), transparent 55%),
			radial-gradient(circle at 28% 82%, rgba(170, 173, 182, 0.22), transparent 50%),
			linear-gradient(160deg, #0b0c0f 0%, #17191f 45%, #0b0c0f 100%);
		background-size:
			180% 180%,
			160% 160%,
			200% 200%,
			170% 170%,
			100% 100%;
		filter: blur(60px);
		animation:
			drift 24s ease-in-out infinite alternate,
			breathe 7s ease-in-out infinite;
		will-change: background-position, transform, opacity;
	}

	@keyframes drift {
		0% {
			background-position:
				10% 20%,
				90% 10%,
				40% 90%,
				20% 70%,
				0 0;
		}
		50% {
			background-position:
				60% 50%,
				30% 60%,
				70% 30%,
				60% 40%,
				0 0;
		}
		100% {
			background-position:
				90% 80%,
				10% 90%,
				20% 60%,
				80% 20%,
				0 0;
		}
	}

	@keyframes breathe {
		0%,
		100% {
			transform: scale(1);
			opacity: 0.85;
		}
		50% {
			transform: scale(1.05);
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#bg {
			animation: none;
		}
	}

	main {
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		color: #f5f5f5;
		padding: 16px;
	}

	h1 {
		font-size: clamp(2.5rem, 6vw, 4rem);
		margin: 0;
		letter-spacing: -0.02em;
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.4);
	}

	#title {
		margin: 0.75em 0 0;
		font-size: 1.15rem;
		color: #c7c9d1;
		font-weight: 500;
	}

	#description {
		margin: 0.5em 0 0;
		font-size: 1rem;
		color: #9ca3af;
		max-width: 32em;
	}

	#badge {
		margin-top: 2em;
		padding: 0.5em 1.25em;
		border: 1px solid #3f4148;
		border-radius: 999px;
		font-size: 0.85rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #d1d5db;
		backdrop-filter: blur(4px);
	}
</style>
